#!/usr/bin/env php
<?php
declare(strict_types=1);

use PieceOfCake2\SecurityDast\Command;

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Command())->run(array_slice($argv, 1), $_SERVER));
